    EDGE_NAME_COLOR        = Color3.fromRGB(255, 255, 255),  -- fallback only
    EDGE_NAME_ALPHA        = 0.9,    -- baseline (not being viewed)
    EDGE_NAME_ALPHA_VIEWED = 0.0,    -- fully visible when viewer is aiming at us
